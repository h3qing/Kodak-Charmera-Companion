# macOS. An unanchored pattern matches at every depth, so this already covers
# docs/.DS_Store, .github/.DS_Store, etc. Files committed *before* the ignore
# rule existed stay tracked — untrack them once with:
#   git rm --cached -r --ignore-unmatch '*.DS_Store'
.DS_Store

.claude/
__pycache__/
*.pyc
*.egg-info/
build/
.eggs/
*.egg
.pytest_cache/
.venv/
venv/
imported/
processed/

# Rust
/target/
# Note: Cargo.lock IS committed (binary app needs reproducible builds)

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.cursor/

# Release packaging staging dir (see .github/workflows/release.yml)
/dist/

# Tauri generated
crates/charmera-app/gen/
.gstack/
